{
    "name": "stylesync",
    "private": true,
    "version": "2.0.0",
    "description": "StyleSync Personal — turn a design you admire into a design system your coding agent can follow.",
    "type": "module",
    "engines": { "node": ">=22" },
    "packageManager": "pnpm@9.15.9",
    "scripts": {
          "build": "pnpm --filter=./packages/* --filter=./apps/* build",
          "typecheck": "pnpm --filter=./packages/* --filter=./apps/* typecheck",
          "test": "pnpm --filter=./packages/* test",
          "cli": "pnpm --filter @stylesync/cli exec stylesync",
          "web": "pnpm --filter @stylesync/web dev",
          "doctor": "pnpm cli doctor"
    },
    "devDependencies": {
          "typescript": "^5.6.3"
    }
}
